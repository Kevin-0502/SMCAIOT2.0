<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutErrorState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:visibility="gone"
    android:background="@android:color/transparent">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:elevation="0dp">

        <View
            android:id="@+id/viewErrorCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_pink" />

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_no_wifi"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sin conexión"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/principal"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="24dp"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/tvErrorDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No fue posible conectar con el servidor.\nRevisa tu internet e inténtalo de nuevo."
        android:textSize="14sp"
        android:textColor="#666666"
        android:fontFamily="sans-serif"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnErrorAction"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:text="Reintentar"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="@color/principal"
        app:strokeWidth="0dp"
        app:cornerRadius="14dp"
        android:elevation="2dp"
        style="@style/Widget.Material3.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tvErrorSecondaryAction"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="Ir al inicio"
        android:textSize="14sp"
        android:textColor="@color/principal"
        android:textAllCaps="false"
        app:backgroundTint="@android:color/transparent"
        app:strokeWidth="0dp"
        app:cornerRadius="10dp"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>